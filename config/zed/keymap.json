[
  {
    "bindings": {
      "alt-/": "project_panel::ToggleFocus",
      "alt-.": "terminal_panel::ToggleFocus",
      "alt-,": "agent::ToggleFocus"
    }
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Editor && mode == full && VimControl && !menu && vim_mode != operator",
    "bindings": {
      "space": null,
      "space a": null,
      "space f": null,
      "space g": null,
      "space p": null,

      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "ctrl-6": "pane::AlternateFile",

      "space g p": "git_panel::ToggleFocus",
      "space g d": "git::Diff",
      "space g r": "git::Restore",
      "space g shift-r": "git::RestoreFile",
      "space g s": "git::ToggleStaged",
      "space g b": "git::Branch",
      "space g n": "git::StageAndNext",
      "space g c": "git::ExpandCommitEditor",

      "space a c": "agent::ToggleFocus",
      "space a i": "assistant::InlineAssist",

      "space p p": "pane::RevealInProjectPanel",
      "space p s": "project_symbols::Toggle",
      "space p f": "file_finder::Toggle",

      "space f f": "file_finder::Toggle",
      "space f s": "outline::Toggle"
    }
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space f f": "file_finder::Toggle"
    }
  },
  {
    "bindings": {
      "ctrl-j": "workspace::ToggleBottomDock",
      "ctrl-h": "workspace::ToggleLeftDock",
      "ctrl-l": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b\r"]
    }
  }
]
