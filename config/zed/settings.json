        }
      ]
    }
  ],
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium"
      },
      "type": "registry"
    }
  },
  "notification_panel": {
    "button": false
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "outline_panel": {
    "default_width": 300.0,
    "dock": "right",
    "button": false,
    "folder_icons": true,
    "file_icons": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "file_finder": {
    "file_icons": true
  },
  "search": {
    "button": false,
    "regex": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": true
  },
  "prettier": {
    "allowed": false
  },
  "format_on_save": "off",
  "preferred_line_length": 88,
  "bottom_dock_layout": "right_aligned",
  "show_whitespaces": "none",
  "current_line_highlight": "all",
  "autosave": {
    "after_delay": {
      "milliseconds": 400
    }
  },

  "show_edit_predictions": false,

  /* Git panel */
  "git_panel": {
    "button": false,
    "dock": "right"
  },

  /* Restore on Startup */
  "restore_on_startup": "empty_tab",

  /* Buffer */
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,
  "buffer_line_height": "comfortable",

  /* Edit Predictions */
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "enabled_in_text_threads": false
  },

  "cursor_blink": false,

  /* Editor Scrollbar */
  "scrollbar": {
    "show": "never"
  },

  /* Editor Tabs */
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },

  /* Formmatter */
  "formatter": null,

  /* File Types */
  "file_types": {
    "JSONC": ["*.json", "*.jsonl"]
  },

  /* Diagnostics */
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
      "min_column": 100
    }
  },

  /* Icon Theme */
  "icon_theme": "Zed (Default)",

  /* Inlay Hints */
  "inlay_hints": {
    "enabled": true
  },

  /* Languages */
  "languages": {
    "HTML": {
      "tab_size": 2
    },
    "Git Config": {
      "tab_size": 2
    },
    "CSS": {
      "tab_size": 2
    },
    "C++": {
      "tab_size": 2
    },
    "C": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "JSON": {
      "tab_size": 2
    },
    "JSONC": {
      "tab_size": 2
    },
    "Svelte": {
      "tab_size": 2
    },
    "Markdown": {
      "show_edit_predictions": false,
      "soft_wrap": "bounded",
      "tab_size": 2
    },
    "Make": {
      "hard_tabs": true
    },
    "Python": {
      "language_servers": [
        "ty",
        "ruff",
        "!basedpyright",
        "!pyrefly",
        "!pyright",
        "!pylsp",
        "..."
      ],
      "formatter": [
        { "code_action": "source.fixAll.ruff" },
        { "code_action": "source.organizeImports.ruff" },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    },
    "Shell Script": {
      "tab_size": 2
    }
  },

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null
        }
      }
    }
  },

  /* Wrap Guides (Verical Rulers) */
  "wrap_guides": [100],

  /* Telemetry */
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  /* Terminal */
  "terminal": {
    "flexible": true,
    "dock": "bottom",
    "button": true,
    "detect_venv": {
      "on": {
        "directories": [".venv"],
        "activate_script": "default"
      }
    },
    "default_width": 560,
    "minimum_contrast": 0
  },

  /* Theme */
  "theme": {
    "mode": "light",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  },

  /* Vim */
  "vim_mode": true,
  "relative_line_numbers": "enabled",

  /* Project Panel */
  "project_panel": {
    "default_width": 280,
    "button": true,
    "dock": "right"
  },

  /* Assistant Panel */
  "agent": {
    "flexible": false,
    "max_content_width": 540.0,
    "new_thread_location": "local_project",
    "dock": "left",
    "enable_feedback": false,
    "use_modifier_to_send": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.2"
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.2"
    },
    "default_profile": "minimal",
    "model_parameters": [
      {
        "temperature": 0.3
      }
    ]
  },

  /* UI Font */
  "ui_font_family": ".SystemUIFont",
  "ui_font_fallbacks": ["Helvetica Neue"],
  "ui_font_size": 16,

  /* Misc. */
  "auto_signature_help": true,
  "use_system_window_tabs": true,
  "show_signature_help_after_edits": true,
  "experimental.theme_overrides": {
    "players": [
      {
        "cursor": "#ffa800"
      }
    ]
  }
}
